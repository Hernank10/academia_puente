[run]
source = .
omit =
    */migrations/*
    */tests/*
    */test_*.py
    */conftest.py
    manage.py
    core/asgi.py
    core/wsgi.py
    arreglar_jsons*.py
    crear_*.py
    diagnostico_*.py
    fix_*.py
    fusionar_*.py
    generar_*.py
    indexar_*.py
    inyectar_*.py
    normalizar_*.py
    poblar_*.py
    prueba_*.py
    reclasificar_*.py
    recuperador_*.py
    reinscribir_*.py
    reporte_*.py
    test_min.py
    _*.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    @abstractmethod
    if TYPE_CHECKING:
    if settings.DEBUG
